[Unit]
Description=Verified SQLite and uploads backup for SM Survival
After=sm-instruction.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/sm-instruction/current/deploy/backup.py
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/sm-instruction
