[Unit]
Description=Build and deploy SM Instruction from GitHub main
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/sm-instruction/github-sync.py
Environment=GIT_TERMINAL_PROMPT=0
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=30min
Nice=10
CPUQuota=150%
MemoryMax=2G
UMask=0022

