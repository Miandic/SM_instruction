# адрес и порт сервера
BIND_ADDR=0.0.0.0:8080
# путь к файлу SQLite
DATABASE_PATH=data.db
# учётка админа (создаётся при первом запуске)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
# общий код для регистрации старост и студентов (пусто = регистрация открыта)
REGISTRATION_CODE=
# Кода организаторов в env больше нет: у каждой точки свой код, он же определяет,
# какую точку ведёт организатор. Коды видны и перегенерируются в админке.
