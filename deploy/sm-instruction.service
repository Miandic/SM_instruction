[Unit]
Description=SM Survival web application
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=sm-instruction
Group=sm-instruction
WorkingDirectory=/opt/sm-instruction/current
EnvironmentFile=/etc/sm-instruction/app.env
ExecStartPre=/usr/bin/python3 /opt/sm-instruction/current/deploy/check-config.py
ExecStart=/opt/sm-instruction/current/sm-instruction
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sm-instruction
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=768M
TasksMax=128
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
